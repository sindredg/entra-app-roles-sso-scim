# Copy to .env on the VM (chmod 600). Never commit .env.

# --- Phase 1 ---
GRAFANA_DOMAIN=<DNS_LABEL>.<REGION>.cloudapp.azure.com
GRAFANA_ADMIN_PASSWORD=<GRAFANA_ADMIN_PASSWORD>   # local break-glass admin; strong + unique

# --- Phase 2: Entra ID OIDC ---
AZUREAD_SSO_ENABLED=false                          # set true after the app registration exists
AZUREAD_TENANT_ID=<TENANT_ID>
AZUREAD_CLIENT_ID=<CLIENT_ID>
AZUREAD_CLIENT_SECRET=<CLIENT_SECRET>

# --- Phase 3: SCIM bridge ---
SCIM_SECRET_TOKEN=<SCIM_SECRET_TOKEN>              # generate: openssl rand -base64 32
